#!/usr/bin/env bash
# The same gate CI's build-and-test job runs (scripts/verify.mjs). Skip a single
# push with `git push --no-verify`.
#
# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref>
# <remote sha>. Pushes that send no new commits (branch deletions, tags only)
# have nothing to verify.
zero=0000000000000000000000000000000000000000
needs_verify=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  case "$local_ref" in refs/tags/*) continue ;; esac
  needs_verify=1
done
[ "$needs_verify" = 1 ] || exit 0
exec pnpm verify
