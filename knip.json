{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "brew",
    "pkexec",
    "ollama",
    "pkill",
    "sqlite3",
    "pgrep"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs"
      ],
      "ignoreDependencies": [
        "better-sqlite3"
      ]
    },
    "apps/dashboard": {
      "entry": [
        "tsup.sidecar.ts",
        "scripts/*.mjs",
        "src/components/ui/*.tsx",
        "templates/configs/compile-instructions.mjs",
        "templates/plugins/opencode/*.ts"
      ],
      "ignoreDependencies": [
        "opencode"
      ]
    },
    "apps/mcp-server": {
      "ignoreDependencies": [
        "drizzle-orm",
        "sqlite-vec"
      ]
    },
    "packages/tests": {
      "entry": [
        "scripts/*.mjs",
        "scripts/**/*.ts"
      ],
      "ignoreDependencies": [
        "tsx"
      ]
    },
    "packages/core": {
      "entry": [
        "src/jobs/*-worker.ts"
      ]
    }
  },
  "ignoreExportsUsedInFile": true
}
