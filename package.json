{
  "name": "cognistore",
  "version": "2.5.3",
  "private": true,
  "description": "Semantic knowledge management for AI agents",
  "scripts": {
    "prepare": "git config core.hooksPath .husky || true",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "bump": "bash scripts/bump-version.sh",
    "check:version": "node scripts/check-release-version.mjs",
    "dmg": "pnpm --filter @cognistore/dashboard tauri:dmg",
    "type-check": "turbo type-check"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.11.0",
      "vite": ">=6.4.4 <7",
      "hono": ">=4.13.11",
      "@babel/core": "7.29.6",
      "esbuild@0.27.7": "0.28.1",
      "@hono/node-server": ">=2.0.5",
      "body-parser": ">=2.4.0",
      "brace-expansion": ">=5.0.12",
      "fast-uri": ">=4.2.3",
      "find-my-way": ">=9.7.0",
      "nanoid": ">=3.3.18 <4",
      "postcss": ">=8.5.18",
      "react-router": ">=7.18.5 <8",
      "react-router-dom": ">=7.18.5 <8",
      "qs": ">=6.16.1",
      "ip-address": ">=10.7.4",
      "proxy-addr": ">=2.0.8",
      "source-map-js": ">=1.2.2",
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0"
    }
  }
}
