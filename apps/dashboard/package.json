{
  "name": "@cognistore/dashboard",
  "version": "2.5.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p server/tsconfig.json",
    "dev": "vite",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "test": "if find . -name '*.test.ts' -o -name '*.spec.ts' | grep -q .; then npx playwright test; else echo 'No tests found, skipping'; fi",
    "server": "tsx server/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:bundle": "node scripts/bundle-sidecar.mjs && tauri build",
    "tauri:dmg": "node scripts/bundle-sidecar.mjs && tauri build --bundles dmg",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cognistore/config": "workspace:*",
    "@cognistore/core": "workspace:*",
    "@cognistore/embeddings": "workspace:*",
    "@cognistore/providers": "workspace:*",
    "@cognistore/sdk": "workspace:*",
    "@cognistore/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.8",
    "@reduxjs/toolkit": "^2.11.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "date-fns": "^4",
    "fastify": "^5.12.7",
    "i18next": "^25.8.18",
    "react": "^19.0.0",
    "react-day-picker": "^9",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.8",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
