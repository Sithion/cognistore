{
  "name": "@cognistore/dashboard",
  "version": "2.5.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p server/tsconfig.json",
    "dev": "vite",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "test": "vitest run",
    "server": "tsx server/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:bundle": "node scripts/bundle-sidecar.mjs && tauri build",
    "tauri:dmg": "node scripts/bundle-sidecar.mjs && tauri build --bundles dmg",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cognistore/config": "workspace:*",
    "@cognistore/core": "workspace:*",
    "@cognistore/embeddings": "workspace:*",
    "@cognistore/providers": "workspace:*",
    "@cognistore/sdk": "workspace:*",
    "@cognistore/shared": "workspace:*",
    "@fastify/cors": "^11.4.0",
    "@fastify/static": "^10.1.8",
    "@reduxjs/toolkit": "^2.13.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "fastify": "^5.12.8",
    "i18next": "^26.7.1",
    "react": "^19.3.1",
    "react-day-picker": "^9",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  }
}
