{
  "tools": [
    {
      "name": "addKnowledge",
      "description": "Store one or multiple knowledge entries. Pass a single object or an array. If you have an active plan, ALWAYS pass planId to auto-link as output.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entries": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Short descriptive title"
                  },
                  "content": {
                    "type": "string",
                    "description": "The knowledge content text"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Categorical tags for filtering"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "decision",
                      "pattern",
                      "fix",
                      "constraint",
                      "gotcha"
                    ],
                    "description": "Type: decision, pattern, fix, constraint, or gotcha"
                  },
                  "scope": {
                    "type": "string",
                    "description": "Scope: \"global\" or \"workspace:<project-name>\""
                  },
                  "source": {
                    "type": "string",
                    "description": "Source of the knowledge"
                  },
                  "confidenceScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Confidence score 0-1"
                  },
                  "agentId": {
                    "type": "string",
                    "description": "Your agent/role name (e.g. 'documentation', 'code-reviewer') so entries can be summarized per agent. Pass it whenever you are a named/custom agent."
                  },
                  "planId": {
                    "type": "string",
                    "description": "Plan ID to auto-link this knowledge as output. ALWAYS pass this if you have an active plan."
                  }
                },
                "required": [
                  "title",
                  "content",
                  "tags",
                  "type",
                  "scope",
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/properties/entries/anyOf/0"
                }
              }
            ],
            "description": "A single knowledge entry object, or an array of entries"
          }
        },
        "required": [
          "entries"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "addPlanRelation",
      "description": "Link a knowledge entry to a plan. Input = consulted during planning, output = created during execution. Usually auto-handled — use only for manual linking.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string",
            "description": "UUID of the plan"
          },
          "knowledgeId": {
            "type": "string",
            "description": "UUID of the knowledge entry to link"
          },
          "relationType": {
            "type": "string",
            "enum": [
              "input",
              "output"
            ],
            "description": "\"input\" = consulted, \"output\" = produced"
          }
        },
        "required": [
          "planId",
          "knowledgeId",
          "relationType"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "addPlanTask",
      "description": "Add a task to a plan. Position is auto-calculated.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string",
            "description": "UUID of the plan"
          },
          "description": {
            "type": "string",
            "description": "Task description"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "description": "Priority (default: medium)"
          },
          "notes": {
            "type": "string",
            "description": "Optional notes"
          }
        },
        "required": [
          "planId",
          "description"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "archivePlan",
      "description": "Archive a plan (status → \"archived\") to take it out of active circulation. Reversible — re-activate via updatePlan. Preferred over deletion: keeps the plan and its linked knowledge.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string",
            "description": "UUID of the plan to archive"
          }
        },
        "required": [
          "planId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "createPlan",
      "description": "Create a plan with tasks. Plan auto-activates when the first task starts. Returns planId — SAVE IT and pass to addKnowledge calls. Pass parentPlanId to link this plan into an existing effort; omit it only when starting a brand-new one.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Plan title (short, descriptive)"
          },
          "content": {
            "type": "string",
            "description": "Full plan content (steps, approach, considerations)"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags for categorization"
          },
          "scope": {
            "type": "string",
            "description": "Scope: \"global\" or \"workspace:<project-name>\""
          },
          "source": {
            "type": "string",
            "description": "Source/context of the plan"
          },
          "planFilePath": {
            "type": "string",
            "description": "ABSOLUTE path to the local plan file you wrote (e.g. a plan-mode file like /home/user/.claude/plans/<name>.md). REQUIRED whenever you persisted the plan to a file — always link it so the CogniStore plan points back to the on-disk file."
          },
          "agentId": {
            "type": "string",
            "description": "Your agent/role name (e.g. 'documentation') so plans can be summarized per agent. Pass it whenever you are a named/custom agent."
          },
          "parentPlanId": {
            "type": "string",
            "description": "UUID of the plan that spawned this one. OMIT ONLY for a brand-new ORIGINAL effort — that plan becomes the root of a chain. ALWAYS pass it for a follow-up plan, and subagents must pass the main effort's plan id, so the whole chain stays linked and the original stays identifiable."
          },
          "relatedKnowledgeIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "IDs of knowledge entries consulted during planning (auto-linked as input)"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "priority": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                }
              },
              "required": [
                "description"
              ],
              "additionalProperties": false
            },
            "description": "Tasks for the plan. ALWAYS include tasks for multi-step work."
          }
        },
        "required": [
          "title",
          "content",
          "tags",
          "scope",
          "source"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
