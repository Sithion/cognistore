    {
      "name": "updatePlan",
      "description": "Update a plan. Status lifecycle: draft → active → completed. Plan auto-activates and auto-completes via task updates — usually you do not need to call this manually.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string",
            "description": "UUID of the plan to update"
          },
          "title": {
            "type": "string",
            "description": "New title"
          },
          "content": {
            "type": "string",
            "description": "New content"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "New tags"
          },
          "scope": {
            "type": "string",
            "description": "New scope"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "completed",
              "archived"
            ],
            "description": "New status (usually auto-managed)"
          },
          "source": {
            "type": "string",
            "description": "New source"
          },
          "planFilePath": {
            "type": "string",
            "description": "ABSOLUTE path to the local plan file (backfill the link if it was not set at createPlan time)."
          },
          "parentPlanId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Link this plan into an existing chain after the fact. Pass null to unlink it, making it the ORIGINAL of its own chain. Rejected if it would point a plan at itself or at one of its own descendants."
          }
        },
        "required": [
          "planId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "updatePlanTask",
      "description": "Update a task status. Plan auto-activates on first in_progress and auto-completes when all tasks are done. Set \"position\" to reorder the task within the plan.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "UUID of the task"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed"
            ],
            "description": "New status"
          },
          "description": {
            "type": "string",
            "description": "New description"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "description": "New priority"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "description": "Notes about progress or blockers"
          },
          "position": {
            "type": "number",
            "description": "New 0-based position; reorders the task within the plan (tasks are listed by position ascending)"
          }
        },
        "required": [
          "taskId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
