    {
      "name": "updateKnowledge",
      "description": "Update an existing knowledge entry. If content changes, embedding is regenerated. Version auto-increments.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "UUID of the knowledge entry to update"
          },
          "title": {
