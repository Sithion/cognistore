              "type": "string"
            },
            "description": "New tags"
          },
          "type": {
            "type": "string",
            "enum": [
              "decision",
              "pattern",
              "fix",
              "constraint",
              "gotcha"
            ],
            "description": "New type"
          },
          "scope": {
            "type": "string",
            "description": "New scope"
          },
          "source": {
            "type": "string",
            "description": "New source"
          },
          "confidenceScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
