    {
      "name": "deletePlanTask",
      "description": "Remove a task from a plan. If the remaining tasks are all completed (and at least one remains), the plan auto-completes. Returns the updated plan context.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "format": "uuid",
            "description": "UUID of the task to remove"
          }
        },
        "required": [
          "taskId"
