{
  "name": "@cognistore/tests",
  "version": "0.9.11",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npx playwright test",
    "test:e2e": "npx playwright test --grep @e2e",
    "test:load": "npx playwright test --grep @load",
    "test:perf": "PERF=1 npx playwright test --project performance --grep @perf --workers=1",
    "build": "echo 'No build needed for test package'",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test:ui": "vitest run --config vitest.ui.config.ts"
  },
  "dependencies": {
    "@cognistore/config": "workspace:*",
    "@cognistore/core": "workspace:*",
    "@cognistore/providers": "workspace:*",
    "@cognistore/sdk": "workspace:*",
    "@cognistore/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "sqlite-vec": "^0.1.9",
    "typescript": "^5.7.0",
    "zod": "^4.6.6",
    "vitest": "5.1.0",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "@axe-core/playwright": "^4.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
