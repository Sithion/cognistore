{
  "name": "@cognistore/core",
  "version": "2.5.4",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && rm -rf dist/db/migrations dist/db/seeds && cp -r src/db/migrations dist/db/migrations && cp -r src/db/seeds dist/db/seeds",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "db:generate": "pnpm build && drizzle-kit generate",
    "db:push": "pnpm build && drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cognistore/shared": "workspace:*",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.0",
    "sqlite-vec": "^0.1.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/coverage-v8": "5.0.4",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.0",
    "vitest": "5.0.4"
  }
}
