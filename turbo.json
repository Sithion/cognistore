{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "dist-server/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ]
    },
    "@cognistore/core#clean-assets": {
      "cache": false
    },
    "@cognistore/core#build": {
      "dependsOn": [
        "^build",
        "@cognistore/core#clean-assets"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
